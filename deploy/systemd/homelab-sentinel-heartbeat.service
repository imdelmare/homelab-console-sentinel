[Unit]
Description=Send Homelab Console heartbeat to External Sentinel
Documentation=docs/SENTINEL.md
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/homelab-console
EnvironmentFile=/etc/homelab-console/sentinel-heartbeat.env
ExecStart=/usr/bin/python -m sentinel.heartbeat_client
Environment=PYTHONPATH=/opt/homelab-console/apps/sentinel
